# Streamlit Secrets Configuration Example
# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > App settings > Secrets.
# Never commit real values.

# Environment: "production" or "development" (default). Also settable via env LUMI_ENV.
# In production, a missing DB_URL logs an error and shows a warning (SQLite is ephemeral on Streamlit Cloud).
env = "development"

# Optional PostHog analytics key (also read from env POSTHOG_API_KEY). Omit to disable.
# POSTHOG_API_KEY = "phc_your_posthog_key_here"

# Passwordless "Sign In with Email" mock login. DEVELOPMENT ONLY — leave false/unset in production.
# Can also be enabled with env LUMI_DEV_AUTH=1 (and is implicitly on when LUMI_TESTING=1).
# NEVER set true in production.
dev_auth = false

[auth]
# Production: "https://<your-app>.streamlit.app/oauth2callback" (must match Google Cloud console exactly).
redirect_uri = "http://localhost:8501/oauth2callback"
# Also used to HMAC-sign Lumi's own cookies (lumi_session, lumi_user_email).
# Use a long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# Fallback: env LUMI_COOKIE_SECRET; otherwise a per-process random secret (cookies reset on restart).
cookie_secret = "your_cookie_secret_here"

[auth.google]
client_id = "your_client_id_here"
client_secret = "your_client_secret_here"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Postgres database connection URL.
# IMPORTANT: When connecting to Supabase or other Postgres servers, always use the 
# transaction-mode connection pooler URI (typically port 6543, with host containing "pooler.supabase.com").
# Avoid using the direct connection string (port 5432, host like "db.[ref].supabase.co")
# because the short-lived query pattern causes excessive socket connection churn.
DB_URL = "postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
